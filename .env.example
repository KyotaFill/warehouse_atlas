# Warehouse Atlas Configuration

# Environment
APP_ENV=development
DEBUG=True
LOG_LEVEL=INFO

# PostgreSQL 16+ Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=warehouse_atlas
DB_USER=postgres
DB_PASSWORD=postgres
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/warehouse_atlas

# Application Timezone
APP_TIMEZONE=Asia/Ho_Chi_Minh

# GUI Settings
GUI_THEME=flatly
GUI_WINDOW_WIDTH=1440
GUI_WINDOW_HEIGHT=900
GUI_MIN_WIDTH=1366
GUI_MIN_HEIGHT=768

# AI Assistant (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_TIMEOUT_SECONDS=30
